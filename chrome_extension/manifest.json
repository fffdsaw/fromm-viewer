{
  "manifest_version": 3,
  "name": "Fromm Stream Nexus Proxy",
  "version": "1.0.6",
  "minimum_chrome_version": "101",
  "description": "Adjusts Fromm API/media CORS headers only for requests initiated by the Fromm Viewer page.",
  "permissions": [
    "declarativeNetRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://fffdsaw.github.io/*",
    "https://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cors_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "key": "",
  "background": {
    "service_worker": "native-background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fffdsaw.github.io/fromm-viewer/*"
      ],
      "js": [
        "native-content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
